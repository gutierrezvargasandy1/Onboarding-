# Copia este archivo como .env (no se sube a git) y ajusta los valores.
# Perfil: dev en local, prod en producción.
SPRING_PROFILES_ACTIVE=dev

# Base de datos
DB_URL=jdbc:postgresql:
DB_USER=postgres
DB_PASSWORD=

# JWT: mínimo 32 caracteres aleatorios. Genera uno con:  openssl rand -base64 48
JWT_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRACION=60m

# Saldo de apertura definido por el sistema (no puede ser negativo)
SALDO_INICIAL=1000.00

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGENES=http://localhost:3000
